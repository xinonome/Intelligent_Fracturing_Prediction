# Local environments and generated caches
.venv/
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tmp/
.env
.env.*
!.env.example

# Historical experiment folders are not part of the frozen handoff.
**/runs/
HMI-KE/outputs/

# Local logs and editor files
*.log
.idea/
.vscode/
.DS_Store
Thumbs.db

# Sensitive source datasets must never be committed or released.
Data/raw_frac/
Data/3Dfrac/

# The following paths are intentionally versioned in this release:
#   artifacts/
#   outputs/app, outputs/dt, outputs/hmi
#   trained model files (*.zip, *.joblib, *.pt)
# Do not add a global *.zip/*.csv/*.pt rule here: it would silently hide
# the frozen models and validation outputs required by the runnable handoff.
